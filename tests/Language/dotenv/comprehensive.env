# Comment line
# Another comment

# Simple key-value
APP_NAME=MyApp
APP_DEBUG=false
PORT=8080

# Quoted values
APP_URL="http://localhost"
DESCRIPTION='Single quoted value'
MULTILINE="First line
Second line"

# Variable substitution
BASE_PATH=/var/www
LOG_PATH=${BASE_PATH}/logs
FULL_URL=${APP_URL}:${PORT}

# Nested substitution
NESTED=${LOG_PATH}/app.log

# Export prefix
export DATABASE_URL=postgres://localhost/db
export API_KEY="secret-key"

# Empty values
EMPTY_VAR=
EMPTY_QUOTED=""

# Values with special chars
SPECIAL="value with spaces"
EQUALS="key=value"
HASH="value#with#hash"
DOLLAR="value$with$dollar"

# No value (just key)
STANDALONE

# Complex combinations
COMPLEX=${VAR1}_${VAR2}_suffix
MIXED="${BASE}/path"_unquoted

# Inline comments should not be recognized as DotEnv doesn't support them
NO_INLINE=value # This is part of the value

# Boolean-like values
ENABLED=true
DISABLED=false
NUMERIC=12345

# URLs and paths
DATABASE_URL="postgresql://user:pass@localhost:5432/dbname"
FILE_PATH=/usr/local/bin:/usr/bin
WINDOWS_PATH="C:\Program Files\App"

# Special export cases
export EXPORTED=value
export QUOTED_EXPORT="exported value"
export VAR_EXPORT=${OTHER_VAR}
